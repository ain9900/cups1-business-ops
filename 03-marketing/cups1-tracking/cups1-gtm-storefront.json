          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function (w, d) {\n  function emit(event, payload) {\n    w.dataLayer = w.dataLayer || [];\n    payload.event = event;\n    w.dataLayer.push(payload);\n  }\n\n  function displayPrice(amount, minorUnit) {\n    if (amount == null || amount === '' || !Number.isInteger(minorUnit) || minorUnit < 0 || minorUnit > 6) return NaN;\n    return Number(amount) / Math.pow(10, minorUnit);\n  }\n\n  function shownVariant(product, button) {\n    if (button && /^\\d+$/.test(button.dataset.cartId || '')) return button.dataset.cartId;\n    var form = product.querySelector('.variations_form');\n    if (!form) return '';\n    var options = Array.from(form.querySelectorAll('select[name^=\"attribute_\"]')).filter(function (select) {\n      return select.value;\n    });\n    if (!options.length) return '';\n    var variants;\n    try { variants = JSON.parse(form.getAttribute('data-product_variations') || '[]'); }\n    catch (error) { return ''; }\n    if (!Array.isArray(variants)) return '';\n    var matching = variants.filter(function (variant) {\n      return variant.attributes && options.every(function (select) {\n        var value = variant.attributes[select.name];\n        return value === '' || value === select.value;\n      });\n    });\n    return matching.length === 1 && /^\\d+$/.test(String(matching[0].variation_id)) ? String(matching[0].variation_id) : '';\n  }\n\n  function viewProduct() {\n    var product = d.querySelector('[data-product-detail]');\n    if (!product) return;\n    var heading = d.getElementById(product.getAttribute('aria-labelledby'));\n    var cartButton = product.querySelector('[data-catalog-cart-item]');\n    var post = /(?:^|\\s)postid-(\\d+)(?:\\s|$)/.exec(d.body.className);\n    var id = shownVariant(product, cartButton) || cartButton && cartButton.dataset.catalogCartItem || post && post[1];\n    var name = heading && heading.textContent.trim();\n    if (/^\\d+$/.test(id || '') && name) emit('cups1_product_view', { items: [{ item_id: id, item_name: name }] });\n  }\n\n  function readCart(event) {\n    fetch('/wp-json/wc/store/v1/cart', { credentials: 'same-origin', cache: 'no-store' })\n      .then(function (response) { return response.ok ? response.json() : null; })\n      .then(function (cart) {\n        if (!cart || !Array.isArray(cart.items) || !cart.items.length) return;\n        var totals = cart.totals || {};\n        var currency = totals.currency_code;\n        var value = displayPrice(totals.total_items, totals.currency_minor_unit);\n        if (!/^[A-Z]{3}$/.test(currency || '') || !Number.isFinite(value) || value < 0) return;\n        var items = cart.items.map(function (entry) {\n          var prices = entry.prices || {};\n          var price = displayPrice(prices.price, prices.currency_minor_unit);\n          if (!/^\\d+$/.test(String(entry.id)) || !entry.name || !Number.isInteger(entry.quantity) || entry.quantity < 1 ||\n              !Number.isFinite(price) || price < 0 || prices.currency_code !== currency) return null;\n          return { item_id: String(entry.id), item_name: entry.name, quantity: entry.quantity, price: price };\n        });\n        if (items.every(Boolean)) emit(event, { currency: currency, value: value, items: items });\n      }).catch(function () { /* Measurement never interrupts the storefront. */ });\n  }\n\n  function track() {\n    var path = w.location.pathname;\n    if (/^\\/product\\/[^/]+\\/?$/.test(path) && d.body.classList.contains('single-product')) viewProduct();\n    else if (/^\\/cart\\/?$/.test(path) && d.body.classList.contains('woocommerce-cart')) readCart('cups1_cart_view');\n    else if (/^\\/checkout\\/?$/.test(path) && d.body.classList.contains('woocommerce-checkout')) readCart('cups1_checkout_start');\n  }\n\n  if (d.readyState === 'complete') track();\n  else w.addEventListener('load', track, { once: true });\n})(window, document);\n</script>"
