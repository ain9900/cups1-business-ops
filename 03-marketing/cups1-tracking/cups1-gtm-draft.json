        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function (w, d) {\n  var id = '{{CONST - Meta Pixel ID}}';\n  if (!/^\\d{8,25}$/.test(id)) return;\n  function safePage(url) {\n    if (/^\\/(?:wp-admin|wp-login\\.php|my-account|checkout)(?:\\/|$)/i.test(url.pathname)) return false;\n    var inquiryRoute = /^(?:\\/$|\\/(?:request-a-quote|request-a-sample|contact-sales|contact|configure-packaging)\\/?$)/.test(url.pathname);\n    if (url.hash && !(inquiryRoute && url.hash === '#quote')) return false;\n    var parameters = new URLSearchParams(url.search);\n    return Array.from(parameters).every(function (entry) {\n      var key = entry[0];\n      var value = entry[1];\n      if (/^utm_(?:source|medium|campaign|id|term|content|source_platform|creative_format|marketing_tactic)$/.test(key)) {\n        return /^[a-z0-9 ._+|():-]{1,128}$/i.test(value);\n      }\n      if (key === 'fbclid') return /^[A-Za-z0-9_-]{1,400}$/.test(value);\n      if (key === 'gtm_debug') return /^\\d{1,20}$/.test(value);\n      if (key === 'collection' && /^\\/products\\/?$/.test(url.pathname)) return /^(?:cups|lids|containers|ware)$/.test(value);\n      if (!inquiryRoute) return false;\n      if (key === 'packaging_product' || key === 'product') {\n        return /^(?:double-wall|single-wall|ripple-wall|dessert|bowls|boxes|other|wc-\\d{1,10})$/.test(value);\n      }\n      if (key === 'packaging_size') return /^\\d{1,4}(?:[.-]\\d{1,4})? *(?:oz|ml|l)$/i.test(value);\n      return key === 'intent' && /^(?:quote|pricing|sample|contact|customize)$/.test(value);\n    });\n  }\n  if (!safePage(w.location)) return;\n  if (d.referrer) {\n    var referrer = new URL(d.referrer);\n    if (referrer.origin === w.location.origin ? !safePage(referrer) : referrer.search || referrer.hash) return;\n  }\n  function shownVariant(product, button) {\n    if (button && /^\\d+$/.test(button.dataset.cartId || '')) return button.dataset.cartId;\n    var form = product.querySelector('.variations_form');\n    if (!form) return '';\n    var options = Array.from(form.querySelectorAll('select[name^=\"attribute_\"]')).filter(function (select) {\n      return select.value;\n    });\n    if (!options.length) return '';\n    var variants;\n    try { variants = JSON.parse(form.getAttribute('data-product_variations') || '[]'); }\n    catch (error) { return ''; }\n    if (!Array.isArray(variants)) return '';\n    var matching = variants.filter(function (variant) {\n      return variant.attributes && options.every(function (select) {\n        var value = variant.attributes[select.name];\n        return value === '' || value === select.value;\n      });\n    });\n    return matching.length === 1 && /^\\d+$/.test(String(matching[0].variation_id)) ? String(matching[0].variation_id) : '';\n  }\n\n  function trackCatalog() {\n    if (/^\\/products\\/?$/.test(w.location.pathname)) {\n      if (!w.cups1MetaCatalogViewed) {\n        var collection = new URLSearchParams(w.location.search).get('collection') || 'all';\n        w.cups1MetaCatalogViewed = true;\n        w.fbq('trackSingleCustom', id, 'ViewCategory', { content_category: collection });\n      }\n      return;\n    }\n    if (!/^\\/product\\/[^/]+\\/?$/.test(w.location.pathname)) return;\n    function send() {\n      if (w.cups1MetaContentViewed || w.cups1MetaRevoked || !safePage(w.location)) return;\n      var product = d.querySelector('[data-product-detail]');\n      if (!product) return;\n      var heading = d.getElementById(product.getAttribute('aria-labelledby'));\n      var button = product.querySelector('[data-catalog-cart-item]');\n      var parent = /(?:^|\\s)postid-(\\d+)(?:\\s|$)/.exec(d.body.className);\n      var variationId = shownVariant(product, button);\n      var productId = variationId || button && button.dataset.catalogCartItem || parent && parent[1];\n      var kind = !variationId && product.querySelector('.variations_form') ? 'product_group' : 'product';\n      if (!/^\\d+$/.test(productId || '') || !heading) return;\n      w.cups1MetaContentViewed = true;\n      w.fbq('trackSingle', id, 'ViewContent', {\n        content_ids: [productId],\n        content_name: heading.textContent.trim(),\n        content_type: kind\n      });\n    }\n    if (d.readyState === 'complete') send();\n    else w.addEventListener('load', send, { once: true });\n  }\n  if (w.cups1MetaPixel === id) {\n    if (w.fbq && w.cups1MetaRevoked) {\n      w.fbq('consent', 'grant');\n      w.cups1MetaRevoked = false;\n      trackCatalog();\n    }\n    return;\n  }\n  if (!w.fbq) {\n    var queue = function () {\n      if (queue.callMethod) queue.callMethod.apply(queue, arguments);\n      else queue.queue.push(arguments);\n    };\n    w.fbq = queue;\n    if (!w._fbq) w._fbq = queue;\n    queue.push = queue;\n    queue.loaded = true;\n    queue.version = '2.0';\n    queue.queue = [];\n    var script = d.createElement('script');\n    script.async = true;\n    script.src = 'https://connect.facebook.net/en_US/fbevents.js';\n    d.head.appendChild(script);\n  }\n  w.fbq('consent', 'grant');\n  w.fbq('set', 'autoConfig', false, id);\n  w.fbq('init', id);\n  w.cups1MetaPixel = id;\n  w.fbq('trackSingle', id, 'PageView');\n  trackCatalog();\n})(window, document);\n</script>"
